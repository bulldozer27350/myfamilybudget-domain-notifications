<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-090 (doc/architecture/20-backlog-modules-maven-patchs.md) : domaine Notifications, devenu
        `notifications-api` à SILO-158 (doc/architecture/21-plan-silotage.md) : contrat NotificationRule /
        NotificationMessage, clés de règles, paramètres métier de notification et entrées des trois règles. Les
        règles (DebitThresholdRule, BalanceFloorRule, ObjectifReachableRule) vivent dans `notifications-core`.

        Notifications définit ses propres contrats d'entrée (SILO-134) : aucune dépendance vers un autre module du
        reactor, ni vers Spring, JPA, Web Push, OpenAPI, PersistenceManager ou BudgetDataModel : seul le JDK est
        utilisé en production, aucune dépendance de test (les tests vivent dans `notifications-core`). La dédup, le
        dispatch, les canaux et la persistance des paramètres restent hors du module (SILO-180).
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>domain-notifications</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>notifications-api</artifactId>
    <packaging>jar</packaging>
    <name>notifications-api</name>
    <description>API du silo Notifications MyFamilyBudget (contrats, paramètres, entrées de règles ; sans Spring ni JPA)</description>


    <build>
        <plugins>
            <!--
                REL-030 : japicmp compare l'API binaire de ce module a sa derniere version publiee
                (oldVersion=RELEASE). ignoreMissingOldVersion=true : ne fait pas echouer le build s'il n'y a
                encore aucune version publiee (silo tout juste cree). breakBuildOnBinaryIncompatibleModifications
                reste a true (herite de <pluginManagement> dans le pom racine) : un changement binaire non
                retrocompatible fait echouer `mvn verify`/`mvn clean verify`. Rapport : target/japicmp/japicmp.diff
                (et .xml) apres `mvn verify`.
            -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <configuration>
                    <oldVersion>
                        <dependency>
                            <groupId>com.moe.myfamilybudget</groupId>
                            <artifactId>notifications-api</artifactId>
                            <version>RELEASE</version>
                        </dependency>
                    </oldVersion>
                    <parameter>
                        <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                        <!-- REL-050 : le rapport XML est necessaire a scripts/suggest-version-bump.py -->
                        <skipXmlReport>false</skipXmlReport>
                    </parameter>
                </configuration>
                <executions>
                    <execution>
                        <id>japicmp</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
